1e:T6ca,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I convert Nepali Date (BS) to English Date (AD) online?","acceptedAnswer":{"@type":"Answer","text":"Select the 'Date Converter' tab above, choose 'BS to AD', pick or type the Bikram Sambat Year, Month, and Day, and the converter will instantly calculate the Gregorian (AD) date along with weekday, full month name, and Devanagari details."}},{"@type":"Question","name":"Can I convert English Date (AD) to Nepali Date (BS)?","acceptedAnswer":{"@type":"Answer","text":"Yes. Select the 'AD to BS' toggle in the Date Converter tool, input any Gregorian date from 1919 to 2044 AD, and get the accurate Bikram Sambat date immediately."}},{"@type":"Question","name":"How does the Nepali Age Calculator work?","acceptedAnswer":{"@type":"Answer","text":"The Age Calculator allows you to enter your date of birth in Bikram Sambat (BS). It calculates your precise age in years, months, and days based on the official Nepali calendar."}},{"@type":"Question","name":"How is the Nepali Date Difference calculated?","acceptedAnswer":{"@type":"Answer","text":"The Date Difference tool measures the exact elapsed time between two Nepali dates, breaking the interval down into total days, weeks, months, and years, accounting for variable month days (29-32 days)."}},{"@type":"Question","name":"What is Nepal's Government Fiscal Year and its quarters?","acceptedAnswer":{"@type":"Answer","text":"The Government of Nepal's fiscal year runs from 1st Shrawan through the end of Ashadh. The Fiscal Year tab calculates the fiscal year (e.g. 2081/82) and provides dates for Q1 (Shrawan-Ashwin), Q2 (Kartik-Poush), Q3 (Magh-Chaitra), and Q4 (Baisakh-Ashadh)."}}]}10:["$","$1","c",{"children":[["$","div",null,{"className":"flex min-h-screen flex-1 flex-col bg-fd-background text-fd-foreground selection:bg-fd-primary/20","children":[["$","script",null,{"id":"converter-webapp-schema","type":"application/ld+json","sup