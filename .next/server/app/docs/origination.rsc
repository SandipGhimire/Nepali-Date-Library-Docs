128:["$","$L119",null,{"as":"h2","id":"astronomical-foundations--calendar-mechanics","children":"Astronomical Foundations & Calendar Mechanics"}]
129:["$","p",null,{"children":["Unlike the Western Gregorian calendar, which is a ",["$","strong",null,{"children":"solar tropical"}]," calendar based on the cycle of the seasons (equinoxes and solstices), Bikram Sambat is a ",["$","strong",null,{"children":["solar sidereal (",["$","em",null,{"children":"Nirayana"}],")"]}]," calendar governed by the principles of classical Hindu astronomy (",["$","em",null,{"children":"Surya Siddhanta"}],")."]}]
12a:["$","$L119",null,{"as":"h3","id":"1-the-sidereal-solar-year-nirayana-saur-varsha","children":["1. The Sidereal Solar Year (",["$","em",null,{"children":"Nirayana Saur Varsha"}],")"]}]
12b:["$","p",null,{"children":"A sidereal year is the time it takes the Earth to complete one full revolution around the Sun relative to the fixed stars."}]
12c:["$","ul",null,{"children":["\n",["$","li",null,{"children":["The tropical year (used by Gregorian) equals approximately ",["$","strong",null,{"children":"365.2422 days"}],"."]}],"\n",["$","li",null,{"children":["The sidereal year (used by Bikram Sambat) equals approximately ",["$","strong",null,{"children":"365.25636 days"}],"."]}],"\n",["$","li",null,{"children":["Due to the precession of the equinoxes (",["$","em",null,{"children":"Ayanamsha"}],"), the sidereal year advances forward relative to the tropical year by approximately ",["$","strong",null,{"children":"1 day every 71.6 years"}],"."]}],"\n"]}]
12d:["$","$L119",null,{"as":"h3","id":"2-solar-ingress-sankranti","children":["2. Solar Ingress (",["$","em",null,{"children":"Sankranti"}],")"]}]
12e:["$","p",null,{"children":["In Bikram Sambat, the first day of every month begins upon the Sun's transit (",["$","em",null,{"children":"Sankranti"}],") from one zodiac constellation (",["$","em",null,{"children":"Rashi"}],") into the next:"]}]
12f:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mesha Sankranti (Aries Ingress)"}],": Marks the entrance of the Sun into the constellation of Mesha (Aries). This exact astronomical occurrence defines ",["$","strong",null,{"children":"Baisakh 1"}],", celebrating ",["$","strong",null,{"children":["Nepali New Year (",["$","em",null,{"children":"Nawa Barsha"}],")"]}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Makar Sankranti (Capricorn Ingress)"}],": Marks the Sun's entrance into Makara, signaling the winter solstice turning point and the festival of ",["$","strong",null,{"children":"Maghe Sankranti"}],"."]}],"\n"]}]
130:["$","$L119",null,{"as":"h3","id":"3-keplers-second-law--variable-month-lengths-29-to-32-days","children":"3. Kepler's Second Law & Variable Month Lengths (29 to 32 Days)"}]
131:["$","p",null,{"children":["A defining characteristic of Bikram Sambat is that ",["$","strong",null,{"children":"month lengths vary between 29 and 32 days from year to year"}],"."]}]
132:["$","p",null,{"children":"This is not arbitrary; it is a direct consequence of celestial mechanics:"}]
133:["$","ol",null,{"children":["\n",["$","li",null,{"children":["According to ",["$","strong",null,{"children":"Kepler's Second Law"}],", Earth travels faster along its elliptical orbit when it is closest to the Sun (perihelion, occurring in early January) and slower when it is farthest from the Sun (aphelion, occurring in early July)."]}],"\n",["$","li",null,{"children":["Because the Earth moves faster during the northern hemisphere's winter, the Sun appears to traverse the winter constellations (Dhanu, Makara, Kumbha) in less time. Consequently, winter months like ",["$","strong",null,{"children":"Kartik, Mangsir, Poush, and Magh"}]," typically span ",["$","strong",null,{"children":"29 to 30 days"}],"."]}],"\n",["$","li",null,{"children":["During the northern hemisphere's summer, the Earth moves slower in its orbit, taking longer to traverse constellations like Mithuna and Karkata. Consequently, summer months like ",["$","strong",null,{"children":"Jestha, Ashadh, Shrawan, and Bhadra"}]," typically span ",["$","strong",null,{"children":"31 to 32 days"}],"."]}],"\n"]}]
134:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"[!NOTE]\nBecause the exact moment of Sankranti can occur at any hour of the day or night, canonical Panchanga rules determine whether the new month begins on the same solar day (if Sankranti occurs before sunset or noon) or the following solar day. This produces variations where a given month may have 31 days in one year, but 32 days in another."}],"\n"]}]
