114:["$","$L117",null,{"children":"Deep dive into the origins, history, astronomical foundation, calendar mechanics, and timeline of Bikram Sambat (विक्रम संवत्)."}]
115:["$","$L118",null,{"children":[[["$","p",null,{"children":["The ",["$","strong",null,{"children":"Nepali Date"}]," is based on the ",["$","strong",null,{"children":"Bikram Sambat"}]," (Devanagari: ",["$","strong",null,{"children":"विक्रम संवत्"}],", abbreviated as ",["$","strong",null,{"children":"BS"}]," or ",["$","strong",null,{"children":"B.S."}],"), the official national civil calendar of ",["$","strong",null,{"children":"Nepal"}],"."]}],"\n",["$","p",null,{"children":["Used across all organs of the Nepalese state—from parliamentary legislation and Supreme Court decrees to banking operations, taxation, school academic sessions, and day-to-day citizen records—Bikram Sambat is a sophisticated ",["$","strong",null,{"children":"solar sidereal calendar"}]," with roots extending over two millennia."]}],"\n",["$","hr",null,{}],"\n",["$","$L119",null,{"as":"h2","id":"historical-genesis-of-bikram-sambat","children":"Historical Genesis of Bikram Sambat"}],"\n",["$","$L119",null,{"as":"h3","id":"the-founding-in-57-bce","children":"The Founding in 57 BCE"}],"\n",["$","p",null,{"children":["Bikram Sambat originated in ",["$","strong",null,{"children":"57 BCE (Before Common Era)"}]," in the ancient city of ",["$","strong",null,{"children":"Ujjain"}]," (in modern Madhya Pradesh, India). According to widespread historical tradition, the era was instituted by ",["$","strong",null,{"children":"King Vikramaditya of Ujjain"}]," to commemorate his decisive military victory over the invading Saka (Indo-Scythian) forces, liberating the region and relieving the financial debt of his citizens."]}],"\n",["$","p",null,{"children":["Because the era was inaugurated in 57 BCE, Bikram Sambat is approximately ",["$","strong",null,{"children":"56.7 years ahead"}]," of the Western Gregorian calendar (Common Era / AD)."]}],"\n",["$","$L119",null,{"as":"h3","id":"evolution-of-the-eras-inscriptional-name","children":"Evolution of the Era's Inscriptional Name"}],"\n",["$","p",null,{"children":"Epigraphic and numismatic records show that the name of this calendar era evolved across three distinct phases:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Krita Era (कृत संवत्)"}],": Earliest stone inscriptions from the 3rd to 5th centuries CE referred to this system as ",["$","em",null,{"children":"Krita"}],", possibly honoring a foundational event or sovereign leader."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Malava Era (मालव संवत्)"}],": Between the 5th and 9th centuries CE, the era was called ",["$","em",null,{"children":"Malava Gana Sambat"}]," (the era of the Malava republic), corresponding to the migration and governance of the Malava tribe."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Vikrama Samvat (विक्रम संवत्)"}],": By the 9th and 10th centuries CE, starting prominently around the Dholpur stone inscription (dated 842 CE / 898 BS), the era became permanently identified with King Vikramaditya."]}],"\n"]}],"\n",["$","hr",null,{}],"\n",["$","$L119",null,{"as":"h2","id":"the-calendar-eras-of-nepal","children":"The Calendar Eras of Nepal"}],"\n",["$","p",null,{"children":"Nepal has one of the world's richest epigraphic and calendar traditions, having utilized several prominent eras throughout its documented history:"}],"\n",["$","$L119",null,{"as":"h3","id":"1-saka-sambat-शक-संवत्---78-ce","children":"1. Saka Sambat (शक संवत् - 78 CE)"}],"\n",["$","p",null,{"children":["Introduced in ancient Nepal during the Licchavi period, the Saka Sambat was the primary calendar of early royal inscriptions. The oldest dated stone epigraph in Nepal—the pillar inscription of ",["$","strong",null,{"children":"King Manadeva I at the Changu Narayan Temple"}],"—is dated ",["$","strong",null,{"children":"386 Saka Sambat (464 CE / 521 BS)"}],"."]}],"\n",["$","$L119",null,{"as":"h3","id":"2-manadeva-sambat--amshuverma-era-576-ce","children":"2. Manadeva Sambat / Amshuverma Era (576 CE)"}],"\n","$L11a","\n","$L11b","\n","$L11c","\n","$L11d","\n","$L11e","\n","$L11f","\n","$L120","\n","$L121","\n","$L122","\n","$L123","\n","$L124","\n","$L125","\n","$L126","\n","$L127","\n","$L128","\n","$L129","\n","$L12a","\n","$L12b","\n","$L12c","\n","$L12d","\n","$L12e","\n","$L12f","\n","$L130","\n","$L131","\n","$L132","\n","$L133","\n","$L134","\n","$L135","\n","$L136","\n","$L137","\n","$L138","\n","$L139","\n","$L13a","\n","$L13b","\n","$L13c","\n","$L13d","\n","$L13e","\n","$L13f","\n","$L140","\n","$L141","\n","$L142","\n","$L143","\n","$L144","\n","$L145","\n","$L146","\n","$L147","\n","$L148","\n","$L149","\n","$L14a","\n","$L14b","\n","$L14c","\n","$L14d","\n","$L14e","\n","$L14f","\n","$L150","\n","$L151","\n","$L152","\n","$L153"],"$L154"]}]
11a:["$","p",null,{"children":"During the late Licchavi period under rulers such as King Amshuverma and King Jisnugupta, a shortened regional calendar system known as the Manadeva Sambat was employed across the Kathmandu Valley for public administration and religious foundations."}]
11b:["$","$L119",null,{"as":"h3","id":"3-nepal-sambat-नेपाल-संवत्---879-ce--936-bs","children":"3. Nepal Sambat (नेपाल संवत् - 879 CE / 936 BS)"}]
11c:["$","p",null,{"children":["Founded by ",["$","strong",null,{"children":"Shankhadhar Sakhwa"}]," on Kartik Shukla Pratipada in 879 CE after he cleared the debts of all citizens in the Kathmandu Valley during the reign of King Raghavadeva. Nepal Sambat served as the principal civic, lunar, and commercial calendar of the Malla Dynasty (1200–1768 CE) and remains revered today as a national heritage calendar of Nepal."]}]
11d:["$","$L119",null,{"as":"h3","id":"4-bikram-sambat-in-ancient-and-medieval-nepal","children":"4. Bikram Sambat in Ancient and Medieval Nepal"}]
11e:["$","p",null,{"children":"While Nepal Sambat predominated in the Kathmandu Valley's domestic trade, Bikram Sambat maintained continuous usage across western and northern Nepal:"}]
11f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["In the ",["$","strong",null,{"children":"Khasa Malla Empire"}]," of the Karnali basin (centered in the Sinja Valley, Jumla), Bikram Sambat was the undisputed official calendar. The ",["$","strong",null,{"children":"Dullu Stone Pillar of King Prithvi Malla"}]," (located in Dailekh) is engraved in Bikram Sambat ",["$","strong",null,{"children":"1414 BS (1357 CE)"}]," using the ancient Khas language."]}],"\n",["$","li",null,{"children":"King Jayasthiti Malla (reigned 1382–1395 CE) and King Pratap Malla of Kathmandu utilized Bikram Sambat alongside Nepal Sambat in stone treaties, temple edicts, and Sanskrit panegyrics."}],"\n"]}]
120:["$","$L119",null,{"as":"h3","id":"5-unification-and-official-adoption-in-nepal-17681901-ce","children":"5. Unification and Official Adoption in Nepal (1768–1901 CE)"}]
121:["$","p",null,{"children":["When ",["$","strong",null,{"children":"King Prithvi Narayan Shah of Gorkha"}]," unified Nepal and established Kathmandu as the capital in ",["$","strong",null,{"children":"1825 BS (1768 CE)"}],", he adopted Bikram Sambat as the standard calendar for royal seals (",["$","em",null,{"children":"Lal Mohar"}],"), military directives, treaties, and administrative governance."]}]
122:["$","p",null,{"children":["In ",["$","strong",null,{"children":"1958 BS (1901 CE)"}],", during the premiership of Rana Prime Minister ",["$","strong",null,{"children":"Chandra Shumsher Jung Bahadur Rana"}],", Bikram Sambat was formally promulgated by imperial decree as the ",["$","strong",null,{"children":"sole official civil and administrative calendar of the Kingdom of Nepal"}],", standardizing astronomical solar calculations across all government offices."]}]
