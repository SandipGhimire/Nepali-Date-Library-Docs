 space-y-1.5","children":["$","p",null,{"children":"King Vikramaditya of Ujjain liberates the Malwa region from invading Saka (Indo-Scythian) rulers. To mark the triumph and provide debt relief to his citizens, the Vikram Samvat era begins, situated approximately 56.7 years ahead of the Common Era (AD)."}]}]]}]]}],["$","div",null,{"className":"relative flex items-start gap-4 sm:gap-6 group","children":[["$","div",null,{"className":"relative z-10 flex size-10 sm:size-12 shrink-0 items-center justify-center rounded-full border-2 border-fd-border bg-fd-background shadow-xs transition-all duration-200 group-hover:border-fd-primary group-hover:scale-105","children":["$","div",null,{"className":"size-3 sm:size-3.5 rounded-full transition-colors bg-fd-primary/70 group-hover:bg-fd-primary"}]}],["$","div",null,{"className":"flex-1 rounded-xl border border-fd-border/70 bg-fd-card/50 p-4 sm:p-5 backdrop-blur-xs transition-all duration-200 hover:border-fd-primary/40 hover:bg-fd-card/80 hover:shadow-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-fd-border/40 pb-2.5 mb-2.5","children":[["$","div",null,{"className":"flex flex-wrap items-center gap-2","children":[["$","span",null,{"className":"font-mono text-sm sm:text-base font-bold text-fd-foreground","children":"78 CE"}],["$","span",null,{"className":"inline-flex items-center rounded-md border border-fd-primary/30 bg-fd-primary/10 px-2 py-0.5 font-mono text-xs font-semibold text-fd-primary","children":"135 BS"}]]}],["$","span",null,{"className":"inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider bg-fd-secondary text-fd-secondary-foreground border border-fd-border","children":"Ancient Era"}]]}],"$L155","$L156"]}]]}],"$L157","$L158","$L159","$L15a","$L15b","$L15c","$L15d","$L15e","$L15f","$L160"]}]]}]
