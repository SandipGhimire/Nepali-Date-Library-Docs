150:["$","p",null,{"children":"When architecting systems supporting Bikram Sambat:"}]
151:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Storage Layer"}],": Store all temporal values in databases as standard UTC timestamps or ISO-8601 Gregorian dates (",["$","code",null,{"children":"YYYY-MM-DD"}],")."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Application Layer"}],": Use ",["$","code",null,{"children":"nepali-date-library"}]," to convert UTC timestamps to Bikram Sambat dates for UI display, fiscal reports, date pickers, and localized formatting."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Form Inputs"}],": Convert user-entered Bikram Sambat values to Gregorian prior to saving in persistent storage."]}],"\n"]}]
152:["$","$L119",null,{"as":"h3","id":"4-nepal-standard-time-npt","children":"4. Nepal Standard Time (NPT)"}]
153:["$","p",null,{"children":["Nepal Standard Time is ",["$","strong",null,{"children":"UTC+05:45"}],", one of the few non-hourly timezones in the world. It is calculated based on the meridian passing through the summit of ",["$","strong",null,{"children":"Mount Gauri Shankar"}]," at longitude ",["$","strong",null,{"children":"86°15' East"}],". When performing date calculations near midnight, ensure that your application accounts for the +05:45 offset to avoid single-day boundary shifts."]}]
