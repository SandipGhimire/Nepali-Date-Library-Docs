h","$ref":"php/methods/get-month.mdx"},{"$id":"php/methods/get-date.mdx","type":"page","name":"date->getDate()","description":"Retrieve the numeric day of the month from a NepaliDate instance.","icon":"$L6a","url":"/docs/php/methods/get-date","$ref":"php/methods/get-date.mdx"},{"$id":"php/methods/get-day.mdx","type":"page","name":"date->getDay()","description":"Retrieve the numeric day of the week index from zero for Sunday through six for Saturday.","icon":"$L6b","url":"/docs/php/methods/get-day","$ref":"php/methods/get-day.mdx"},{"$id":"php/methods/get-hours.mdx","type":"page","name":"date->getHours()","description":"Retrieve the hour component from zero to twenty three for the current date instance.","icon":"$L6c","url":"/docs/php/methods/get-hours","$ref":"php/methods/get-hours.mdx"},{"$id":"php/methods/get-minutes.mdx","type":"page","name":"date->getMinutes()","description":"Retrieve the minute component from zero to fifty nine for the current date instance.","icon":"$L6d","url":"/docs/php/methods/get-minutes","$ref":"php/methods/get-minutes.mdx"},{"$id":"php/methods/get-seconds.mdx","type":"page","name":"date->getSeconds()","description":"Retrieve the second component from zero to fifty nine for the current date instance.","icon":"$L6e","url":"/docs/php/methods/get-seconds","$ref":"php/methods/get-seconds.mdx"},{"$id":"php/methods/get-milliseconds.mdx","type":"page","name":"date->getMilliseconds()","description":"Retrieve the millisecond component from zero to nine hundred ninety nine.","icon":"$L6f","url":"/docs/php/methods/get-milliseconds","$ref":"php/methods/get-milliseconds.mdx"},{"$id":"php/methods/get-time.mdx","type":"page","name":"date->getTime()","description":"Retrieve the numeric timestamp in milliseconds since the Unix epoch.","icon":"$L70","url":"/docs/php/methods/get-time","$ref":"php/methods/get-time.mdx"},{"$id":"php/methods/get-english-date.mdx","type":"page","name":"date->getEnglishDate()","description":"Retrieve the equivalent Gregorian dat