r from a NepaliDate instance.","icon":"$L1b","url":"/docs/nodejs/methods/get-year","$ref":"nodejs/methods/get-year.mdx"},{"$id":"nodejs/methods/get-month.mdx","type":"page","name":"date.getMonth()","description":"Retrieve the zero based Bikram Sambat month index from zero for Baisakh to eleven for Chaitra.","icon":"$L1c","url":"/docs/nodejs/methods/get-month","$ref":"nodejs/methods/get-month.mdx"},{"$id":"nodejs/methods/get-date.mdx","type":"page","name":"date.getDate()","description":"Retrieve the numeric day of the month from a NepaliDate instance.","icon":"$L1d","url":"/docs/nodejs/methods/get-date","$ref":"nodejs/methods/get-date.mdx"},{"$id":"nodejs/methods/get-day.mdx","type":"page","name":"date.getDay()","description":"Retrieve the numeric day of the week index from zero for Sunday through six for Saturday.","icon":"$L1e","url":"/docs/nodejs/methods/get-day","$ref":"nodejs/methods/get-day.mdx"},{"$id":"nodejs/methods/get-hours.mdx","type":"page","name":"date.getHours()","description":"Retrieve the hour component from zero to twenty three for the current date instance.","icon":"$L1f","url":"/docs/nodejs/methods/get-hours","$ref":"nodejs/methods/get-hours.mdx"},{"$id":"nodejs/methods/get-minutes.mdx","type":"page","name":"date.getMinutes()","description":"Retrieve the minute component from zero to fifty nine for the current date instance.","icon":"$L20","url":"/docs/nodejs/methods/get-minutes","$ref":"nodejs/methods/get-minutes.mdx"},{"$id":"nodejs/methods/get-seconds.mdx","type":"page","name":"date.getSeconds()","description":"Retrieve the second component from zero to fifty nine for the current date instance.","icon":"$L21","url":"/docs/nodejs/methods/get-seconds","$ref":"nodejs/methods/get-seconds.mdx"},{"$id":"nodejs/methods/get-milliseconds.mdx","type":"page","name":"date.getMilliseconds()","description":"Retrieve the millisecond component from zero to nine hundred ninety nine.","icon":"$L22","url":"/docs/nodejs/methods/get-milliseconds","$ref":"nodejs/methods/get-milliseconds.mdx"},{"$id":"nodejs/methods/get-time.mdx","type":"page","name":"date.getTime()","description":"Retrieve the numeric timestamp in milliseconds since the Unix epoch.","icon":"$L23","url":"/docs/nodejs/methods/get-time","$ref":"nodejs/methods/get-time.mdx"},{"$id":"nodejs/methods/get-english-date.mdx","type":"page","name":"date.getEnglishDate()","description":"Retrieve the equivalent Gregorian date as a native JavaScript Date object.","icon":"$L24","url":"/docs/nodejs/methods/get-english-date","$ref":"nodejs/methods/get-english-date.mdx"},{"$id":"_2","type":"separator","name":"Setters"},{"$id":"nodejs/methods/set.mdx","type":"page","name":"date.set()","description":"Set year, month, and day coordinates simultaneously on a NepaliDate instance.","icon":"$L25","url":"/docs/nodejs/methods/set","$ref":"nodejs/methods/set.mdx"},{"$id":"nodejs/methods/set-year.mdx","type":"page","name":"date.setYear()","description":"Set the Bikram Sambat year on a NepaliDate instance within the supported calendar range.","icon":"$L26","url":"/docs/nodejs/methods/set-year","$ref":"nodejs/methods/set-year.mdx"},{"$id":"nodejs/methods/set-month.mdx","type":"page","name":"date.setMonth()","description":"Set the Bikram Sambat month index on a NepaliDate instance with automatic day clamping.","icon":"$L27","url":"/docs/nodejs/methods/set-month","$ref":"nodejs/methods/set-month.mdx"},{"$id":"nodejs/methods/set-date.mdx","type":"page","name":"date.setDate()","description":"Set the day of the month on a NepaliDate instance and recalculate its timestamp.","icon":"$L28","url":"/docs/nodejs/methods/set-date","$ref":"nodejs/methods/set-date.mdx"},{"$id":"nodejs/methods/parse.mdx","type":"page","name":"date.parse()","description":"Parse a formatted Bikram Sambat date string and update the current date instance in place.","icon":"$L29","url":"/docs/nodejs/methods/parse","$ref":"nodejs/methods/parse.mdx"},{"$id":"_3","type":"separator","name":"Manipulation"},{"$id":"nodejs/methods/add-days.mdx","type":"page","name":"date.addDays()","description":"Add or subtract a specified number of days to a NepaliDate instance with automatic month and year rollover.","icon":"$L2a","url":"/docs/nodejs/methods/add-days","$ref":"nodejs/methods/add-days.mdx"},{"$id":"nodejs/methods/add-months.mdx","type":"page","name":"date.addMonths()","description":"Add or subtract months to a NepaliDate instance while adjusting for variable month lengths.","icon":"$L2b","url":"/docs/nodejs/methods/add-months","$ref":"nodejs/methods/add-months.mdx"},{"$id":"nodejs/methods/add-years.mdx","type":"page","name":"date.addYears()","description":"Add or subtract years to a NepaliDate instance while preserving month and day values.","icon":"$L2c","url":"/docs/nodejs/methods/add-years","$ref":"nodejs/methods/add-years.mdx"},{"$id":"nodejs/methods/diff.mdx","type":"page","name":"date.diff()","description":"Calculate the chronological difference between two NepaliDate instances in specific time units.","icon":"$L2d","url":"/docs/nodejs/methods/diff","$ref":"nodejs/methods/diff.mdx"},{"$id":"nodejs/methods/start-of-day.mdx","type":"page","name":"date.startOfDay()","description":"Return a new NepaliDate instance set to the first moment of the current day at midnight.","icon":"$L2e","url":"/docs/nodejs/methods/start-of-day","$ref":"nodejs/methods/start-of-day.mdx"},{"$id":"nodejs/methods/end-of-day.mdx","type":"page","name":"date.endOfDay()","description":"Return a new NepaliDate instance set to the final millisecond of the current day.","icon":"$L2f","url":"/docs/nodejs/methods/end-of-day","$ref":"nodejs/methods/end-of-day.mdx"},{"$id":"nodejs/methods/start-of-week.mdx","type":"page","name":"date.startOfWeek()","description":"Return a new NepaliDate instance set to the first day of the week on Sunday.","icon":"$L30","url":"/docs/nodejs/methods/start-of-week","$ref":"nodejs/methods/start-of-week.mdx"},{"$id":"nodejs/methods/end-of-week.mdx","type":"page","name":"date.endOfWeek()","description":"Return a new NepaliDate instance set to the final day of the current week on Saturday.","icon":"$L31","url":"/docs/nodejs/methods/end-of-week","$ref":"nodejs/methods/end-of-week.mdx"},{"$id":"nodejs/methods/start-of-month.mdx","type":"page","name":"date.startOfMonth()","description":"Return a new NepaliDate instance set to the first day of the current Bikram Sambat month.","icon":"$L32","url":"/docs/nodejs/methods/start-of-month","$ref":"nodejs/methods/start-of-month.mdx"},{"$id":"nodejs/methods/end-of-month.mdx","type":"page","name":"date.endOfMonth()","description":"Return a new NepaliDate instance set to the final day of the current Bikram Sambat month.","icon":"$L33","url":"/docs/nodejs/methods/end-of-month","$ref":"nodejs/methods/end-of-month.mdx"},{"$id":"nodejs/methods/start-of-year.mdx","type":"page","name":"date.startOfYear()","description":"Return a new NepaliDate instance set to the first day of the Bikram Sambat year on 1 Baisakh.","icon":"$L34","url":"/docs/nodejs/methods/start-of-year","$ref":"nodejs/methods/start-of-year.mdx"},{"$id":"nodejs/methods/end-of-year.mdx","type":"page","name":"date.endOfYear()","description":"Return a new NepaliDate instance set to the final day of the Bikram Sambat year on the last day of Chaitra.","icon":"$L35","url":"/docs/nodejs/methods/end-of-year","$ref":"nodejs/methods/end-of-year.mdx"},{"$id":"_4","type":"separator","name":"Query"},{"$id":"nodejs/methods/is-before.mdx","type":"page","name":"date.isBefore()","description":"Check whether the current date occurs chronologically before another specified date.","icon":"$L36","url":"/docs/nodejs/methods/is-before","$ref":"nodejs/methods/is-before.mdx"},{"$id":"nodejs/methods/is-after.mdx","type":"page","name":"date.isAfter()","description":"Check whether the current date occurs chronologically after another specified date.","icon":"$L37","url":"/docs/nodejs/methods/is-after","$ref":"nodejs/methods/is-after.mdx"},{"$id":"nodejs/methods/is-equal.mdx","type":"page","name":"date.isEqual()","description":"Check whether two date instances share the exact same calendar date coordinates regardless of time.","icon":"$L38","url":"/docs/nodejs/methods/is-equal","$ref":"nodejs/methods/is-equal.mdx"},{"$id":"nodejs/methods/is-same.mdx","type":"page","name":"date.isSame()","description":"Check whether two dates match across a specified granularity such as year, month, or day.","icon":"$L39","url":"/docs/nodejs/methods/is-same","$ref":"nodejs/methods/is-same.mdx"},{"$id":"nodejs/methods/is-valid.mdx","type":"page","name":"date.isValid()","description":"Validate whether the current NepaliDate instance represents a legitimate calendar date within supported bounds.","icon":"$L3a","url":"/docs/nodejs/methods/is-valid","$ref":"nodejs/methods/is-valid.mdx"},{"$id":"nodejs/methods/is-leap-year.mdx","type":"page","name":"date.isLeapYear()","description":"Determine whether the current Bikram Sambat calendar year has three hundred sixty six or more days.","icon":"$L3b","url":"/docs/nodejs/methods/is-leap-year","$ref":"nodejs/methods/is-leap-year.mdx"},{"$id":"nodejs/methods/days-in-month.mdx","type":"page","name":"date.daysInMonth()","description":"Retrieve the total number of days in the current or specified Bikram Sambat month.","icon":"$L3c","url":"/docs/nodejs/methods/days-in-month","$ref":"nodejs/methods/days-in-month.mdx"},{"$id":"nodejs/methods/get-weeks-in-month.mdx","type":"page","name":"date.getWeeksInMonth()","description":"Calculate the number of calendar week rows required to render the current month in a grid.","icon":"$L3d","url":"/docs/nodejs/methods/get-weeks-in-month","$ref":"nodejs/methods/get-weeks-in-month.mdx"},{"$id":"nodejs/methods/get-current-quarter.mdx","type":"page","name":"date.getCurrentQuarter()","description":"Return the standard Bikram Sambat calendar quarter number from one to four for the current date.","icon":"$L3e","url":"/docs/nodejs/methods/get-current-quarter","$ref":"nodejs/methods/get-current-quarter.mdx"},{"$id