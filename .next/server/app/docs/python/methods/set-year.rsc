mponent from zero to fifty nine for the current date instance.","icon":"$L26","url":"/docs/nodejs/methods/get-seconds","$ref":"nodejs/methods/get-seconds.mdx"},{"$id":"nodejs/methods/get-milliseconds.mdx","type":"page","name":"date.getMilliseconds()","description":"Retrieve the millisecond component from zero to nine hundred ninety nine.","icon":"$L27","url":"/docs/nodejs/methods/get-milliseconds","$ref":"nodejs/methods/get-milliseconds.mdx"},{"$id":"nodejs/methods/get-time.mdx","type":"page","name":"date.getTime()","description":"Retrieve the numeric timestamp in milliseconds since the Unix epoch.","icon":"$L28","url":"/docs/nodejs/methods/get-time","$ref":"nodejs/methods/get-time.mdx"},{"$id":"nodejs/methods/get-english-date.mdx","type":"page","name":"date.getEnglishDate()","description":"Retrieve the equivalent Gregorian date as a native JavaScript Date object.","icon":"$L29","url":"/docs/nodejs/methods/get-english-date","$ref":"nodejs/methods/get-english-date.mdx"},{"$id":"_2","type":"separator","icon":"$undefined","name":"Setters"},{"$id":"nodejs/methods/set.mdx","type":"page","name":"date.set()","description":"Set year, month, and day coordinates simultaneously on a NepaliDate instance.","icon":"$L2a","url":"/docs/nodejs/methods/set","$ref":"nodejs/methods/set.mdx"},{"$id":"nodejs/methods/set-year.mdx","type":"page","name":"date.setYear()","description":"Set the Bikram Sambat year on a NepaliDate instance within the supported calendar range.","icon":"$L2b","url":"/docs/nodejs/methods/set-year","$ref":"nodejs/methods/set-year.mdx"},{"$id":"nodejs/methods/set-month.mdx","type":"page","name":"date.setMonth()","description":"Set the Bikram Sambat month index on a NepaliDate instance with automatic day clamping.","icon":"$L2c","url":"/docs/nodejs/methods/set-month","$ref":"nodejs/methods/set-month.mdx"},{"$id":"nodejs/methods/set-date.mdx","type":"page","name":"date.setDate()","description":"Set the day of the month on a NepaliDate instance and recalculate its time