46:["$","p",null,{"children":["The Bikram Sambat year consists of ",["$","strong",null,{"children":"12 solar months"}]," categorized into ",["$","strong",null,{"children":["six traditional two-month seasons (",["$","em",null,{"children":"Ritus"}],")"]}],":"]}]
