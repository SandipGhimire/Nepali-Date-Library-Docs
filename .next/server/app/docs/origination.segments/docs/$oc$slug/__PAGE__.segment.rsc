5a:["$","p",null,{"children":["In Bikram Sambat, ",["$","strong",null,{"children":"no such modular formula exists"}],". Because month lengths depend on the precise astronomical minute of the Sun's transit across constellations as observed from Kathmandu, month lengths are certified yearly by the ",["$","strong",null,{"children":"Nepal Panchanga Nirnayak Samiti"}],"."]}]
5b:["$","$L28",null,{"as":"h3","id":"2-high-precision-ephemeris-lookup-tables","children":"2. High-Precision Ephemeris Lookup Tables"}]
5c:["$","p",null,{"children":"Reliable date libraries must embed pre-computed, verified lookup matrices containing the exact month lengths for each historical and future Bikram Sambat year."}]
5d:["$","p",null,{"children":["The ",["$","strong",null,{"children":"Nepali Date Library"}]," embeds validated ephemeris data covering ",["$","strong",null,{"children":"1976 BS through 2100 BS"}]," (spanning more than 124 years), ensuring 100% deterministic arithmetic and conversions."]}]
5e:["$","$L28",null,{"as":"h3","id":"3-database-architecture-recommendation","children":"3. Database Architecture Recommendation"}]
5f:["$","p",null,{"children":"When architecting systems supporting Bikram Sambat:"}]
60:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Storage Layer"}],": Store all temporal values in databases as standard UTC timestamps or ISO-8601 Gregorian dates (",["$","code",null,{"children":"YYYY-MM-DD"}],")."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Application Layer"}],": Use ",["$","code",null,{"children":"nepali-date-library"}]," to convert UTC timestamps to Bikram Sambat dates for UI display, fiscal reports, date pickers, and localized formatting."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Form Inputs"}],": Convert user-entered Bikram Sambat values to Gregorian prior to saving in persistent storage."]}],"\n"]}]
