20:["$","p",null,{"children":"Developers working across full-stack applications (e.g., a Python backend with a Node.js frontend or a PHP Laravel service with a TypeScript worker) enjoy identical method names, formatting tokens, and date manipulation semantics."}]
21:["$","$L18",null,{"as":"h3","id":"3-certified-astronomical-ephemeris-1976--2100-bs","children":"3. Certified Astronomical Ephemeris (1976 – 2100 BS)"}]
22:["$","p",null,{"children":["Because Bikram Sambat months are based on solar ingress (",["$","em",null,{"children":"Sankranti"}],") and vary from 29 to 32 days based on Keplerian orbital mechanics, the library embeds verified ephemeris tables spanning over 124 years (",["$","strong",null,{"children":"1976/01/01 to 2100/12/31 BS"}],")."]}]
23:["$","$L18",null,{"as":"h3","id":"4-high-throughput-performance","children":"4. High-Throughput Performance"}]
24:["$","p",null,{"children":"All date conversions and arithmetic execute in under a few microseconds, making the library suitable for high-frequency database batch migrations, real-time analytics pipelines, and edge compute functions."}]
25:["$","$L18",null,{"as":"h3","id":"5-built-in-nepalese-fiscal-year-logic","children":"5. Built-In Nepalese Fiscal Year Logic"}]
26:["$","p",null,{"children":["Native support for Nepal's official fiscal calendar (",["$","em",null,{"children":"Aarthik Barsha"}],"), running from 1 Shrawan to the final day of Ashadh, including quarter categorization (Q1 to Q4) and fiscal year string formatting (",["$","code",null,{"children":"2081/82"}],")."]}]
