1d:["$","$L18",null,{"as":"h3","id":"1-zero-external-dependencies","children":"1. Zero External Dependencies"}]
1e:["$","p",null,{"children":"Every package in the suite is built from the ground up without runtime external dependencies. This eliminates supply-chain risks, avoids version conflicts, and keeps bundle footprints minimal."}]
