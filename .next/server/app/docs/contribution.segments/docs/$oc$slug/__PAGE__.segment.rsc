20:["$","ol",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Zero External Runtime Dependencies"}],":\nAll three language packages (",["$","code",null,{"children":"nepali-date-library"}],") MUST maintain zero external dependencies at runtime. Do not add runtime packages."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Standardized Cross-Language Semantics"}],":\nThe API surface across Node.js, Python, and PHP is intentionally synchronized. Method names, formatting tokens (e.g. ",["$","code",null,{"children":"YYYY-MM-DD"}],", ",["$","code",null,{"children":"dddd"}],"), fiscal year quarters, and edge case handling should match across all implementations."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Certified Range Accuracy (1976 – 2100 BS)"}],":\nAny changes affecting date conversion or calendar math must pass the exhaustive ephemeris verification tests covering 1976/01/01 to 2100/12/31 BS."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Deterministic Timezone Isolation"}],":\nDate arithmetic, weekday getters, and day start/end calculations must execute deterministically regardless of the host machine's local timezone."]}],"\n"]}],"\n"]}]
