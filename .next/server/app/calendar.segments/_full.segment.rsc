1d:T6ca,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the Nepali Calendar (Bikram Sambat)?","acceptedAnswer":{"@type":"Answer","text":"The Nepali Calendar is based on the Bikram Sambat (BS) solar sidereal calendar system, which is the official national calendar of Nepal. It is approximately 56.7 years ahead of the Western Gregorian (AD) calendar."}},{"@type":"Question","name":"Why are Saturdays and Sundays highlighted in red on this calendar?","acceptedAnswer":{"@type":"Answer","text":"In Nepal, Saturday (शनिबार) is the official weekly public holiday (weekend), traditionally marked in vibrant red across all official Nepali Patro publications. Sundays are also accented in red for international weekend clarity."}},{"@type":"Question","name":"How do I see both Nepali and English (Gregorian) dates?","acceptedAnswer":{"@type":"Answer","text":"Each cell displays the primary Nepali Bikram Sambat date in prominent Devanagari numerals along with Western digits, accompanied by the corresponding Gregorian (AD) date at the bottom of the cell."}},{"@type":"Question","name":"Can I jump to any year or month?","acceptedAnswer":{"@type":"Answer","text":"Yes. Use the Year and Month dropdown menus at the top of the calendar to navigate any year between 1976 BS and 2100 BS. Click 'Today (आज)' anytime to instantly return to today's date."}},{"@type":"Question","name":"How can I convert a calendar date to English (AD)?","acceptedAnswer":{"@type":"Answer","text":"Click on any day cell in the calendar grid. The details panel will instantly show the full Bikram Sambat and Gregorian equivalents with one-click copy buttons and a direct link to the Date Converter suite."}}]}10:["$","$1","c",{"children":[["$","div",null,{"className":"flex min-h-screen flex-1 flex-col bg-fd-background text-fd-foreground selection:bg-fd-primary/20","children":[["$","script",null,{"id":"calendar-webapp-schema","type":"application/ld+json","suppressHydrationWarning":true,"dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Nepali Calendar - Online Bikram Sambat (BS) Patro\",\"url\":\"https://nepali-pkg.date/calendar\",\"description\":\"Free interactive online Nepali Calendar (Bikram Sambat / BS Patro). View monthly calendar grid with English and Nepali dates, Saturday weekend holidays, and today highlights.\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"All Web Browsers\",\"browserRequirements\":\"Requires JavaScript\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"},\"featureList\":[\"Bikram Sambat (BS) Monthly Calendar Grid\",\"Corresponding Gregorian (AD) Date Overlay\",\"Saturday and Sunday Weekend Red Highlights\",\"Today Date Indicator in Devanagari\",\"Nepali Government Fiscal Year (Aarthik Barsha) Details\",\"Quick Navigation across 1976 to 2100 BS\"]}"}}],["$","script",null,{"id":"calendar-faq-schema","type":"application/ld+json","suppressHydrationWarning":true,"dangerouslySetInnerHTML":{"__html":"$1d"}}],["$","main",null,{"className":"flex flex-1 flex-col w-full","children":[["$","section",null,{"className":"relative isolate overflow-hidden border-b border-fd-border/70 text-center","children":[["$","div",null,{"aria-hidden":"true","className":"pointer-events-none absolute inset-x-0 top-0 -z-10 sm:h-[840px] md:h-[920px] lg:h-[980px] overflow-hidden select-none h-full","children":["$L1e","$L1f"]}],"$L20"]}],"$L21"]}],"$L22"]}],["$L23"],"$L24"]}]
