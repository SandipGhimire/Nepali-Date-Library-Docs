# Nepali Date Library Documentation Environment Variables

# Site Base URL (used for canonical links, sitemaps, openGraph)
NEXT_PUBLIC_SITE_URL=https://nepali-pkg.date

# Google AdSense Configuration
# Replace ca-pub-XXXXXXXXXXXXXXXX with your actual Google AdSense Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Specific Ad Unit Slot IDs (leave blank for responsive auto units)
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CONVERTER=
NEXT_PUBLIC_ADSENSE_SLOT_DOCS=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_TOC=
