# Nepali Date Library Documentation Environment Variables

# Site Base URL (used for canonical links, sitemaps, openGraph)
NEXT_PUBLIC_SITE_URL=https://nepali-pkg.date

# ----------------------------------------------------------------------------
# Google AdSense Configuration (Live Runtime Server-side - No Rebuild Needed!)
# Set this on your live server in .env and simply restart your systemd service.
# ----------------------------------------------------------------------------
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
